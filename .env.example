
PORT=3000
NODE_ENV=development

# Leave AI_ENABLED=false for local-only testing.
AI_ENABLED=false

# Configure only after the hosting environment and provider are approved.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Replace with an actual approved service origin when deploying.
ALLOWED_ORIGIN=http://localhost:3000

# Keep audit output outside the web root.
AUDIT_FILE=./private/audit.jsonl
